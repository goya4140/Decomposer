{
  "model": {
    "backend": "external-json",
    "name": "MODEL_NAME",
    "command": [
      "python3",
      "adapters/openai_compatible_vision.py"
    ],
    "arguments": [
      "--stage",
      "{stage}",
      "--schema",
      "{schema_file}",
      "--image",
      "{image_file}",
      "--base-url-env",
      "MODEL_BASE_URL",
      "--api-key-env",
      "MODEL_API_KEY",
      "--model-env",
      "MODEL_NAME",
      "--response-mode",
      "json_schema"
    ],
    "environment_allowlist": [
      "MODEL_BASE_URL",
      "MODEL_API_KEY",
      "MODEL_NAME"
    ],
    "timeout_seconds": 1800
  }
}
