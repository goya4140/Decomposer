# Required: vision-capable, OpenAI-compatible Chat Completions endpoint.
# Include /v1 if your provider requires it. Do not append /chat/completions.
DECOMPOSER_BASE_URL=https://api.example.com/v1
DECOMPOSER_API_KEY=replace-with-your-api-key
DECOMPOSER_MODEL=replace-with-your-vision-model

# json_schema, json_object or prompt_only. Choose a mode supported by your provider.
DECOMPOSER_RESPONSE_MODE=json_schema
# Leave empty unless your model supports reasoning_effort.
DECOMPOSER_REASONING_EFFORT=
DECOMPOSER_API_TIMEOUT=900
DECOMPOSER_REFINEMENT_ROUNDS=1
DECOMPOSER_OCR_LANG=eng

# Local-only browser access by default. Set a token before exposing the service.
DECOMPOSER_HOST=127.0.0.1
DECOMPOSER_PORT=7860
DECOMPOSER_ACCESS_TOKEN=
